# Supabase Konfiguration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (Supabase Postgres, direkte Verbindung)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Frontend URL (fuer Invite-Links, Stripe-Redirects)
# Development:
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://buerolist-frontend.vercel.app

# Passwort-Reset Redirect (optional, ueberschreibt FRONTEND_URL + /reset-password)
# FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Port (optional - default 3001)
PORT=3001

# CORS (kommagetrennt, optional - Default: localhost:3000 + Vercel-Frontend-URL)
# CORS_ORIGINS=http://localhost:3000,https://buerolist-frontend.vercel.app

# Stripe (Self-Service Organisation-Erstellung, bezahlter "pro"-Tarif)
# Ohne diese Variablen funktioniert die Erstellung im "free"-Tarif weiterhin,
# nur "pro" benoetigt einen konfigurierten Stripe Account.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
